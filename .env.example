# ─── Database ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Cache ─────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# ─── GitHub API ────────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens
# Required scopes: (none — public repo read is unauthenticated)
# Having a token still bumps rate limit from 60 to 5,000 req/hr
GITHUB_TOKEN=ghp_<personal-access-token>

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://depgraph.vedanshh.dev
NODE_ENV=development

# ─── Auth (Week 3) ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=8f4c2d1e9b7a6c5d3f8a1b7e9c2d4f6a8b1c3d5e7f9a2b4c6d8e1f3a5b7c9d
NEXTAUTH_URL=https://depgraph.vedanshh.dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Billing (Week 4) ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Razorpay Plans (Week 5) ──────────────────────────────────────────────────────
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_TEAM=

# ─── Email / Resend (Week 5) ──────────────────────────────────────────────────────
# Create at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# ─── Cron (Week 4) ─────────────────────────────────────────────────────────────
CRON_SECRET=
